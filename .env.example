# Copy this file to .env and fill in your credentials.
#
#   cp .env.example .env
#
# Never commit the .env file to version control.

# -------------------------------------------------------------------
# OpenRouter configuration  (https://openrouter.ai)
# -------------------------------------------------------------------

# Required: Your OpenRouter API key (starts with sk-or-)
OPENROUTER_API_KEY=sk-or-...your-key-here...

# Optional: Override the OpenRouter base URL (default shown below)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: The model to use — any model available on OpenRouter.
# See https://openrouter.ai/models for the full list.
# Examples:
#   openai/gpt-4o-mini          (default)
#   openai/gpt-4o
#   anthropic/claude-3.5-sonnet
#   google/gemini-flash-1.5
OPENROUTER_MODEL=openai/gpt-4o-mini
